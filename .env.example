# Copy this file to .env and fill in the values.
#
# Day 1 needs no API keys — the LLM runs locally via Ollama and the
# embedding model is downloaded from HuggingFace and run locally too.
#
# Day 2 adds one external API: Adzuna, used by get_job_recommendation
# in shared_tools.py and mcp_server.py. Free keys (no card needed):
#   https://developer.adzuna.com/  ->  sign up  ->  create an app
# Without them those tools return {"exception": "AUTH_FAIL"}; everything
# else in the notebook still runs.

#================ADZUNA SETTINGS==============
ADZUNA_APP_ID=
ADZUNA_API_KEY=
